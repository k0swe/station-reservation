{
  "projectId": "station-reservation",
  "projectName": "Club Shack",
  "endpoint": "https://appwrite.rmham.org/v1",
  "functions": [
    {
      "$id": "api",
      "name": "Club Shack API",
      "runtime": "node-24",
      "execute": ["users"],
      "events": [],
      "schedule": "",
      "timeout": 15,
      "enabled": true,
      "logging": true,
      "entrypoint": "src/main.js",
      "commands": "npm ci",
      "path": "functions/api",
      "scopes": ["users.read", "tables.read", "rows.read", "rows.write"]
    }
  ],
  "tablesDB": [
    {
      "$id": "clubshack",
      "name": "Club Shack",
      "enabled": true
    }
  ],
  "tables": [
    {
      "$id": "clubs",
      "databaseId": "clubshack",
      "name": "Clubs",
      "enabled": true,
      "rowSecurity": false,
      "$permissions": [],
      "columns": [
        {
          "key": "name",
          "type": "string",
          "size": 255,
          "required": true,
          "array": false,
          "default": null
        },
        { "key": "slug", "type": "string", "size": 128, "required": false, "array": false }
      ],
      "indexes": [
        { "key": "clubs_name_idx", "type": "key", "columns": ["name"], "orders": ["ASC"] },
        {
          "key": "clubs_slug_unique_idx",
          "type": "unique",
          "columns": ["slug"],
          "orders": ["ASC"]
        }
      ]
    },
    {
      "$id": "users",
      "databaseId": "clubshack",
      "name": "User profiles",
      "enabled": true,
      "rowSecurity": false,
      "$permissions": [],
      "columns": [
        { "key": "email", "type": "string", "size": 320, "required": false, "array": false },
        { "key": "display_name", "type": "string", "size": 255, "required": false, "array": false },
        { "key": "callsign", "type": "string", "size": 32, "required": false, "array": false },
        { "key": "phone_number", "type": "string", "size": 32, "required": false, "array": false }
      ],
      "indexes": []
    },
    {
      "$id": "memberships",
      "databaseId": "clubshack",
      "name": "Memberships",
      "enabled": true,
      "rowSecurity": false,
      "$permissions": [],
      "columns": [
        {
          "key": "club_id",
          "type": "string",
          "size": 36,
          "required": true,
          "array": false,
          "default": null
        },
        {
          "key": "user_id",
          "type": "string",
          "size": 36,
          "required": true,
          "array": false,
          "default": null
        },
        {
          "key": "role",
          "type": "string",
          "size": 32,
          "required": false,
          "array": false,
          "default": "member"
        },
        {
          "key": "status",
          "type": "string",
          "size": 32,
          "required": false,
          "array": false,
          "default": "pending"
        }
      ],
      "indexes": [
        {
          "key": "memberships_club_user_unique_idx",
          "type": "unique",
          "columns": ["club_id", "user_id"],
          "orders": ["ASC", "ASC"]
        },
        {
          "key": "memberships_user_idx",
          "type": "key",
          "columns": ["user_id"],
          "orders": ["ASC"]
        }
      ]
    },
    {
      "$id": "resources",
      "databaseId": "clubshack",
      "name": "Resources",
      "enabled": true,
      "rowSecurity": false,
      "$permissions": [],
      "columns": [
        {
          "key": "club_id",
          "type": "string",
          "size": 36,
          "required": true,
          "array": false,
          "default": null
        },
        {
          "key": "name",
          "type": "string",
          "size": 255,
          "required": true,
          "array": false,
          "default": null
        },
        { "key": "description", "type": "string", "size": 2000, "required": false, "array": false },
        {
          "key": "block_size_minutes",
          "type": "integer",
          "required": true,
          "array": false,
          "default": null,
          "min": 1,
          "max": 1440
        },
        {
          "key": "is_active",
          "type": "boolean",
          "required": false,
          "array": false,
          "default": true
        }
      ],
      "indexes": [
        {
          "key": "resources_club_idx",
          "type": "key",
          "columns": ["club_id", "name"],
          "orders": ["ASC", "ASC"]
        }
      ]
    },
    {
      "$id": "resource_access_approvals",
      "databaseId": "clubshack",
      "name": "Resource access approvals",
      "enabled": true,
      "rowSecurity": false,
      "$permissions": [],
      "columns": [
        {
          "key": "membership_id",
          "type": "string",
          "size": 36,
          "required": true,
          "array": false,
          "default": null
        },
        {
          "key": "resource_id",
          "type": "string",
          "size": 36,
          "required": true,
          "array": false,
          "default": null
        },
        {
          "key": "status",
          "type": "string",
          "size": 32,
          "required": false,
          "array": false,
          "default": "pending"
        }
      ],
      "indexes": [
        {
          "key": "approvals_member_resource_uidx",
          "type": "unique",
          "columns": ["membership_id", "resource_id"],
          "orders": ["ASC", "ASC"]
        },
        {
          "key": "approvals_resource_idx",
          "type": "key",
          "columns": ["resource_id"],
          "orders": ["ASC"]
        }
      ]
    },
    {
      "$id": "reservations",
      "databaseId": "clubshack",
      "name": "Reservations",
      "enabled": true,
      "rowSecurity": false,
      "$permissions": [],
      "columns": [
        {
          "key": "resource_id",
          "type": "string",
          "size": 36,
          "required": true,
          "array": false,
          "default": null
        },
        {
          "key": "membership_id",
          "type": "string",
          "size": 36,
          "required": true,
          "array": false,
          "default": null
        },
        {
          "key": "starts_at",
          "type": "datetime",
          "required": true,
          "array": false,
          "default": null
        },
        {
          "key": "ends_at",
          "type": "datetime",
          "required": true,
          "array": false,
          "default": null
        },
        {
          "key": "status",
          "type": "string",
          "size": 32,
          "required": false,
          "array": false,
          "default": "active"
        }
      ],
      "indexes": [
        {
          "key": "reservations_resource_range_idx",
          "type": "key",
          "columns": ["resource_id", "status", "starts_at"],
          "orders": ["ASC", "ASC", "ASC"]
        },
        {
          "key": "reservations_membership_idx",
          "type": "key",
          "columns": ["membership_id"],
          "orders": ["ASC"]
        }
      ]
    },
    {
      "$id": "reservation_audit_events",
      "databaseId": "clubshack",
      "name": "Reservation audit events",
      "enabled": true,
      "rowSecurity": false,
      "$permissions": [],
      "columns": [
        {
          "key": "reservation_id",
          "type": "string",
          "size": 36,
          "required": true,
          "array": false,
          "default": null
        },
        {
          "key": "event_type",
          "type": "string",
          "size": 32,
          "required": true,
          "array": false,
          "default": null
        },
        {
          "key": "actor_user_id",
          "type": "string",
          "size": 36,
          "required": true,
          "array": false,
          "default": null
        },
        { "key": "notes", "type": "string", "size": 2000, "required": false, "array": false }
      ],
      "indexes": [
        {
          "key": "audit_reservation_idx",
          "type": "key",
          "columns": ["reservation_id"],
          "orders": ["ASC"]
        }
      ]
    }
  ]
}
